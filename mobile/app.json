{
  "expo": {
    "name": "Tatvivah",
    "slug": "tatvivah",
    "version": "3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Tatvivah to convert your speech into search text.",
        "NSMicrophoneUsageDescription": "Allow Tatvivah to use your microphone for voice search."
      },
      "bundleIdentifier": "com.zaheen.iqbal.mobile"
    },
    "android": {
      "versionCode": 18,
      "adaptiveIcon": {
        "backgroundColor": "#FFFCF8",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zaheen.iqbal.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B7956C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tatvivah to select a photo for virtual try-on and product reviews.",
          "cameraPermission": "Allow Tatvivah to take a photo for virtual try-on.",
          "microphonePermission": "Allow Tatvivah to record audio when capturing media."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Tatvivah to use your microphone for voice search.",
          "speechRecognitionPermission": "Allow Tatvivah to convert your speech into search text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-video",
      "expo-font",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "13fff0d2-6600-4b3e-9817-6a17f872adc6"
      }
    },
    "owner": "zaheen.iqbal"
  }
}
